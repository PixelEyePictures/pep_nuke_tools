Gizmo {
 addUserKnob {20 cpm_tab l "CornerPin Matrix v2"}
 addUserKnob {26 cpm_head l "" +STARTLINE T "Corner-pin that outputs its 3x3 as a Nuke 4x4 matrix (v2: transpose + live link)."}
 addUserKnob {41 to1 T CP.to1}
 addUserKnob {41 to2 T CP.to2}
 addUserKnob {41 to3 T CP.to3}
 addUserKnob {41 to4 T CP.to4}
 addUserKnob {26 sp_to l "" +STARTLINE}
 addUserKnob {41 from1 T CP.from1}
 addUserKnob {41 from2 T CP.from2}
 addUserKnob {41 from3 T CP.from3}
 addUserKnob {41 from4 T CP.from4}
 addUserKnob {26 sp_from l "" +STARTLINE}
 addUserKnob {41 invert l "invert (to->from)" T CP.invert}
 addUserKnob {6 transpose l "swap rows/columns (transpose)" t "Flips the matrix across its diagonal. Turn on only if a matrix pasted from another app comes in mirrored / wrong." +STARTLINE}
 addUserKnob {26 pep_div l "" +STARTLINE}
 addUserKnob {26 pep_credit l "" +STARTLINE T "Pixel Eye Pictures  |  <a href=\"https://github.com/PixelEyePictures/pep_nuke_tools\"><font color=\"#7aa2f7\">GitHub</font></a>"}
 addUserKnob {20 cpm_mtx l Matrix}
 addUserKnob {1 target l "target node" t "Node that Paste / Live link writes into. Type its name, or select it and click 'Set from selected'. If empty, the currently selected node is used."}
 addUserKnob {22 settarget l "Set from selected" -STARTLINE T "import pep_cornerpin_matrix as pm\npm.gizmo_set_target(nuke.thisNode())"}
 addUserKnob {26 sp_t l "" +STARTLINE}
 addUserKnob {78 matrix l "live matrix" n 16}
 matrix {{"\[python -execlocal \{import pep_cornerpin_matrix as _p;ret=_p.live_cell(nuke.thisNode(),0)\}]"} {"\[python -execlocal \{import pep_cornerpin_matrix as _p;ret=_p.live_cell(nuke.thisNode(),1)\}]"} {"\[python -execlocal \{import pep_cornerpin_matrix as _p;ret=_p.live_cell(nuke.thisNode(),2)\}]"} {"\[python -execlocal \{import pep_cornerpin_matrix as _p;ret=_p.live_cell(nuke.thisNode(),3)\}]"} {"\[python -execlocal \{import pep_cornerpin_matrix as _p;ret=_p.live_cell(nuke.thisNode(),4)\}]"} {"\[python -execlocal \{import pep_cornerpin_matrix as _p;ret=_p.live_cell(nuke.thisNode(),5)\}]"} {"\[python -execlocal \{import pep_cornerpin_matrix as _p;ret=_p.live_cell(nuke.thisNode(),6)\}]"} {"\[python -execlocal \{import pep_cornerpin_matrix as _p;ret=_p.live_cell(nuke.thisNode(),7)\}]"} {"\[python -execlocal \{import pep_cornerpin_matrix as _p;ret=_p.live_cell(nuke.thisNode(),8)\}]"} {"\[python -execlocal \{import pep_cornerpin_matrix as _p;ret=_p.live_cell(nuke.thisNode(),9)\}]"} {"\[python -execlocal \{import pep_cornerpin_matrix as _p;ret=_p.live_cell(nuke.thisNode(),10)\}]"} {"\[python -execlocal \{import pep_cornerpin_matrix as _p;ret=_p.live_cell(nuke.thisNode(),11)\}]"} {"\[python -execlocal \{import pep_cornerpin_matrix as _p;ret=_p.live_cell(nuke.thisNode(),12)\}]"} {"\[python -execlocal \{import pep_cornerpin_matrix as _p;ret=_p.live_cell(nuke.thisNode(),13)\}]"} {"\[python -execlocal \{import pep_cornerpin_matrix as _p;ret=_p.live_cell(nuke.thisNode(),14)\}]"} {"\[python -execlocal \{import pep_cornerpin_matrix as _p;ret=_p.live_cell(nuke.thisNode(),15)\}]"}}
 addUserKnob {43 matrix_str l readout}
 addUserKnob {22 solve l "Solve readout" -STARTLINE T "import pep_cornerpin_matrix as pm\npm.gizmo_solve(nuke.thisNode())"}
 addUserKnob {22 copymtx l "Copy to clipboard" -STARTLINE T "import pep_cornerpin_matrix as pm\npm.gizmo_copy(nuke.thisNode())"}
 addUserKnob {26 sp_b l "" +STARTLINE}
 addUserKnob {6 bake l "bake animation over range when pasting" +STARTLINE}
 addUserKnob {3 first}
 first 1
 addUserKnob {3 last -STARTLINE}
 last 100
 addUserKnob {22 paste l "Paste matrix into target" -STARTLINE T "import pep_cornerpin_matrix as pm\npm.gizmo_paste(nuke.thisNode())"}
 addUserKnob {22 link l "Live link into target (CornerPin only)" -STARTLINE T "import pep_cornerpin_matrix as pm\npm.gizmo_link(nuke.thisNode())"}
 addUserKnob {20 help_tab l Help}
 addUserKnob {26 help_txt l "" +STARTLINE T "<b>PEP CornerPin to Matrix v2</b><br><br>Turns a corner-pin into a 4x4 matrix and drives another node with it, so a Roto / RotoPaint follows the pin.<br><br><b>1.</b> Set this node's <i>to/from</i> corners (or link them to your tracked CornerPin).<br><b>2.</b> Name the node to drive in <i>target node</i> (or select it and press <i>Set from selected</i>).<br><b>3.</b> On the Matrix tab press <i>Paste matrix into target</i>. Tick <i>bake</i> + set first/last for tracked (animated) pins.<br><b>4.</b> Or press <i>Live link</i> so the target updates as the corners move (CornerPin target only; not Roto).<br><br><b>invert</b> - flip the direction if it moves the wrong way.<br><b>swap rows/columns</b> - only for matrices pasted from other apps that come in mirrored.<br><br>Targets: CornerPin2D (image warp) and Roto/RotoPaint (shape follow). Roto/RotoPaint use <i>Paste</i> (their transform can't be live-linked)."}
}
 Input {
  inputs 0
  name Input1
 }
 CornerPin2D {
  to1 {0 0}
  to2 {2048 0}
  to3 {2048 1556}
  to4 {0 1556}
  invert false
  from1 {0 0}
  from2 {2048 0}
  from3 {2048 1556}
  from4 {0 1556}
  name CP
 }
 Output {
  name Output1
 }
end_group
